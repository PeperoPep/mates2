#!/bin/bash

# omarchy:summary=Remove the Microsoft Outlook, Office, Teams, and OneDrive web apps.

set -e

for app in "Microsoft Outlook" "Microsoft Office" "Microsoft Teams" "Microsoft OneDrive"; do
  if sed -sn '/^\[Desktop Entry\]$/,/^\[/{/^Exec=/p}' "$HOME/.local/share/applications/$app.desktop" 2>/dev/null | grep -q '^Exec=omarchy-launch-webapp '; then
    omarchy-webapp-remove "$app"
  fi
done

echo ""
echo "Microsoft Outlook, Office, Teams, and OneDrive have been removed."
